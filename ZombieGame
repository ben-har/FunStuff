{
    public class Zombie
    {
        private int dmg;
        private int health;
        private int speed;
        private string name;

        public int Dmg { get { return this.dmg; } set { this.dmg = value; } }
        public int Health { get { return this.health; } set { this.health = value; } }
        public int Speed { get { return this.speed; } set { this.speed = value; } }
        public string Name { get { return this.name; } set { this.name  = value; } }

        public Zombie(int Dmg,int Health, int Speed, string Name)
        {
            this.dmg = Dmg;
            this.health = Health;
            this.speed = Speed;
            this.name = Name;





        }
        public override string ToString()
        {
            return $"the damage of this zombie is {Dmg}, the health of this zombie is {Health}, the speed of this zombie is {Speed}, the type of zombie this is {Name}";

        }
        
       
    }
    public class DmgZombie : Zombie
    {
        private int dmgreduction;
        public int DmgReduction { get { return this.dmgreduction;} set { this.dmgreduction = value; } }

        public DmgZombie(int Dmg, int Health, int Speed, string Name, int Dmgreduction)
                : base(Dmg, Health, Speed, Name)
        { 
            this.dmgreduction = Dmgreduction;
        }

        public override string ToString()
        {
            return $"the damage of this zombie is {Dmg}, the health of this zombie is {Health}, the speed of this zombie is {Speed}, the type of this zombie is {Name}, the damage reduction from this zombie is {DmgReduction} ";

        }

    }
    public class HealerZombie : Zombie
    {
        private int heal;
        public int Heal { get { return this.heal; } set { this.heal = value; } }

        public HealerZombie(int Dmg, int Health, int Speed, string Name, int Heal)
                : base(Dmg, Health, Speed, Name)
        {
            this.heal = Heal;
        }
        public override string ToString()
        {
            return $"the damage of this zombie is {Dmg}, the health of this zombie is {Health}, the speed of this zombie is {Speed}, the type of this zombie is {Name}, the healing this zombie can do is {Heal} ";

        }



    }
    public class FastZombie : Zombie
